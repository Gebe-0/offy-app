{
  "name": "offy-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm --filter @offy/api dev",
    "start": "pnpm --filter @offy/api start",
    "build": "pnpm --filter @offy/contracts build && pnpm --filter @offy/core build && pnpm --filter @offy/api build",
    "migrate": "node scripts/migrate.mjs",
    "smoke": "pnpm --filter @offy/api exec tsx src/smoke.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "postgres": "^3.4.5"
  }
}
