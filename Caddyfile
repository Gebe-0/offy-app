http://137.131.148.92, http://137.131.148.92.sslip.io, https://137.131.148.92.sslip.io, https://api.cloudfy.shop, https://cloudfy.shop, :80 {
	encode zstd gzip

	@health path /health
	handle @health {
		reverse_proxy api:8080
	}

	@appRoutes path /v1/* /track* /playlist* /album* /artist* /jam*
	handle @appRoutes {
		reverse_proxy api:8080 {
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	handle {
		reverse_proxy api:8080
	}

	log {
		output stdout
		format console
	}
}
