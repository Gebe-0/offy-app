:80 {
	redir https://api.cloudfy.shop{uri} permanent
}

https://api.cloudfy.shop, https://cloudfy.shop {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	@health path /health
	handle @health {
		reverse_proxy api:8080
	}

	@appRoutes path /v1/* /track* /playlist* /album* /artist* /jam*
	handle @appRoutes {
		reverse_proxy api:8080 {
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	handle {
		reverse_proxy api:8080
	}

	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					replace token REDACTED
				}
				request>headers>Authorization delete
			}
		}
	}
}
