http://137.131.148.92, http://137.131.148.92.sslip.io, https://137.131.148.92.sslip.io, https://api.cloudfy.shop, https://cloudfy.shop, :80 {
	encode zstd gzip

	@health path /health
	handle @health {
		reverse_proxy api:8080
	}

	handle /v1/* {
		reverse_proxy api:8080 {
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	handle {
		respond "OFFY API" 200
	}

	log {
		output stdout
		format console
	}
}
